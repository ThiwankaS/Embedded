# ─── Secrets & local credentials (never commit) ─────────────────────────────
.env
.env.*
!.env.example

# PlatformIO / firmware: copy from *secrets.example.h* or similar templates
**/include/secrets.h
**/secrets.local.h
**/credentials.h
**/private_config.h
**/local_secrets.h

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
*.der

# Optional: override templates stay tracked; real keys stay untracked
!**/secrets.example.h
!**/credentials.example.h

# ─── PlatformIO ──────────────────────────────────────────────────────────────
.pio/
.pioenvs/
.piolibdeps/
platformio.local.ini

# ─── CMake (out-of-source builds) ───────────────────────────────────────────
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json

# ─── Python ─────────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
dist/

# ─── Node (if you add JS tooling) ──────────────────────────────────────────
node_modules/

# ─── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.netrwhist
.Trash-*/

# Language servers, index caches, tags (not project .clangd *files*)
.cache/
.clangd/
/tags
/tags.lock
gtags.files
GPATH
GRTAGS
GTAGS
cscope.out

# Editor backup / swap
*.bak
*.tmp
*.temp

# Logs
*.log
