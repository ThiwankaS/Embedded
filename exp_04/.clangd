# Parse as host C++ (clangd cannot target Xtensa). Real builds still use compile_commands
# from PlatformIO (xtensa-lx106-elf-g++). Regenerate: pio run -t compiledb
#
# Neovim: pass --query-driver to clangd (see README.md in this folder or exp_01) if you drop Compiler: clang++.

CompileFlags:
  CompilationDatabase: .
  Compiler: clang++
  # F() in Arduino expands via PSTR(); newlib's sys/pgmspace.h is often missing on host parses
  # when pp_file_not_found is suppressed — define PSTR as a plain string literal for LSP only.
  Add:
    - '-DPSTR(s)=(s)'
  Remove:
    - -mlongcalls
    - -mtext-section-literals
    - -free
    - -fipa-pta

Diagnostics:
  Suppress:
    - redefinition_different_typedef
    - pp_file_not_found
